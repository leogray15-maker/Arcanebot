# Copy to .env (which is git-ignored) and fill in. NEVER commit real credentials.
# Demo account only until backtest is approved.

METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=
METAAPI_DOMAIN=agiliumtrade.agiliumtrade.ai

# Trading mode guard: must be explicitly set to "demo" for any live execution.
# Anything else (including empty) keeps execution disabled.
TRADING_MODE=backtest
